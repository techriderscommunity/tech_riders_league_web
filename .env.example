DATABASE_URL=postgresql://league:replace-me@localhost:5432/league
# Production: Azure PostgreSQL with verified TLS. Never disable certificate validation.
DATABASE_SSL=false
DATABASE_CA_FILE=
# Azure passwordless authentication; keep password mode for local PostgreSQL.
DATABASE_AUTH=password
AZURE_CLIENT_ID=
APP_URL=http://localhost:3000
MAIL_FROM=Tech Riders League <techriders@tajamar365.com>
# Enable only after configuring the approved sender/provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Private bootstrap configuration; never expose through NEXT_PUBLIC_*.
BOOTSTRAP_EMAIL=
REGISTRATION_ENABLED=false
# GitHub App for captain identity and private repository READ access only.
# Configure OAuth callback: APP_URL/api/github/callback. Enable PKCE.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_FILE=
# 32 random bytes encoded as base64. Keep backed up privately; encrypted snapshots depend on it.
GITHUB_SNAPSHOT_KEY=
# Separate publisher App installed ONLY on techriderscommunity/tech_riders_league.
# Contents write + Pull requests write. Never share this credential with team repositories.
GITHUB_PUBLISHER_APP_ID=
GITHUB_PUBLISHER_PRIVATE_KEY_FILE=
GITHUB_PUBLISHER_INSTALLATION_ID=
GITHUB_PUBLISHER_REPOSITORY_ID=
